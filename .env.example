# Copy this file to .env and edit it. scripts/gateway.sh and docker compose read it.
# Write VALUE without quotes. A variable that is set in your shell wins over this file.

# Consumer keys that clients send as "Authorization: Bearer <key>".
# Leave it empty to turn authentication off (local work only).
AIGW_API_KEYS=dev-key

# Router score (0 to 1) at or above which a "model": "auto" request goes to the strong tier.
AIGW_ROUTER_THRESHOLD=0.5

# Cheap tier: a small, fast model. Any OpenAI-compatible server works.
# For Docker, use http://host.docker.internal:11434/v1 to reach Ollama on your Mac.
AIGW_CHEAP_BASE_URL=http://127.0.0.1:11434/v1
AIGW_CHEAP_MODEL=qwen2.5:0.5b
AIGW_CHEAP_API_KEY=

# Strong tier: a larger model, local or in the cloud.
AIGW_STRONG_BASE_URL=http://127.0.0.1:11434/v1
AIGW_STRONG_MODEL=gpt-oss:20b
AIGW_STRONG_API_KEY=

# Set to false if an upstream rejects stream_options.include_usage.
AIGW_CHEAP_STREAM_USAGE=true
AIGW_STRONG_STREAM_USAGE=true

# Semantic cache. Start the sidecar first with 'make semcache-run'.
# Leave AIGW_CACHE_ADDR empty to turn the cache off.
AIGW_CACHE_ADDR=unix:/tmp/aigw-semcache.sock
# Optional override of the cosine similarity for a hit. Leave it empty: the
# sidecar uses the threshold that belongs to its model (semcache.json). With
# the cross-encoder check (make semcache-run SEMCACHE_RERANK=<folder>), it is
# the similarity for a candidate (rerank.json).
AIGW_CACHE_THRESHOLD=
AIGW_CACHE_TTL=3600
AIGW_CACHE_TIMEOUT_MS=500
